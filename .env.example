# =============================================================================
# Solar - Docker Environment Configuration
# Copy this file to .env and customize for your setup
# =============================================================================

# =============================================================================
# Django / Application Settings
# =============================================================================

# Debug mode (set to False in production)
DJANGO_DEBUG=True

# Secret key for Django (CHANGE THIS IN PRODUCTION!)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-change-in-production

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database (SQLite - built-in, no external service needed)
# =============================================================================

# SQLite database file path (uses volume for persistence)
DJANGO_DATABASE_PATH=/app/db.sqlite3

# =============================================================================
# LLM Service Configuration
# Solar connects to any OpenAI-compatible endpoint (Ollama, Together.ai, etc.)
# =============================================================================

# LLM API endpoint (e.g., http://localhost:11434/v1 for Ollama)
LLM_ENDPOINT=http://host.docker.internal:11434/v1

# LLM API key (if required by your provider)
LLM_API_KEY=

# LLM model name (matches what's available at endpoint)
LLM_MODEL=qwen2.5:1.5b

# Maximum tokens per response
LLM_MAX_TOKENS=500

# =============================================================================
# Audio/TTS Service Configuration
# Chatterbox-TTS runs as a separate Docker container (solar-tts)
# =============================================================================

# TTS service endpoint
# - Docker: http://tts:8001/v1/audio (internal network)
# - Local dev: http://localhost:8001/v1/audio
TTS_ENDPOINT=http://tts:8001/v1/audio

# TTS service API key (if required by your TTS provider)
TTS_API_KEY=

# Whether to pre-render audio in background (optional)
TTS_PRE_RENDER_ENABLED=False

# =============================================================================
# TTS Container Configuration
# =============================================================================

# Device for TTS model inference: "cuda" (GPU) or "cpu"
# GPU recommended for production (much faster)
TTS_DEVICE=cuda

# Local path to cached Chatterbox model (optional, for faster startup)
# If not set, model will be downloaded on first run (~2GB)
CHATTERBOX_LOCAL_PATH=/app/models/chatterbox-turbo

# =============================================================================
# Universe Import Settings
# =============================================================================

# Path to XML universe definition file (relative to project root)
UNIVERSE_XML_PATH=xml/milkyway-v005.xml

# =============================================================================
# Performance Settings
# =============================================================================

# Time scale multiplier for simulation (1x = real-time, 60x = 60x faster)
SIMULATION_TIME_SCALE=1

# LLM latency budget in seconds (for prefetch scheduling)
LLM_SAFE_LATENCY_SECONDS=3.0
