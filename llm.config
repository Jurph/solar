# Configuration for the LLM service. Adjust the values as needed.
# By default, this assumes you have set up ollama running locally with a lightweight Qwen2.5 model 
# but any OpenAI compatible endpoint can be used! 

api_base: "http://localhost:11434/v1"  # Base URL (and port if necessary) for an OpenAI-compliant endpoint
api_key: "ollama"                      # API key for authentication - local ollama uses this dummy value 
model_name: "qwen2.5:1.5b"             # Model name for generating responses 

# =======
# Some "model_name" options include: 
# "llama3"
# "qwen2.5:1.5b"
# You can run `ollama list` at the CLI to see what models are available locally. 
# Check ollama documentation and online resources to see what model names exist.
# Use `ollama pull $NAME` to add new models locally (these are multi-GB files!)
# =======

temperature: 0.7                       # Controls randomness of responses (0 is staid; 1 is zany)
max_tokens: 200                        # Maximum number of tokens in the response